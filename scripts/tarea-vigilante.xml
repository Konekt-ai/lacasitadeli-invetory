<?xml version="1.0" encoding="UTF-16"?>
<!--
  Tarea programada "LacasitaInvetory".

  OJO: este archivo es la PLANTILLA. No se registra tal cual.
  scripts\instalar-tarea.bat reemplaza los dos marcadores y guarda una copia
  temporal en Unicode (que es lo que pide schtasks) antes de darla de alta:

     __RUTA_REPO__  ->  la carpeta del repo, por ejemplo
                        C:\Users\LACASITA\Desktop\lacasitadeli-invetory
     __USUARIO__    ->  el usuario de la tienda, por ejemplo LACASITA

  Por que estas opciones:
   - BootTrigger: al prender la computadora levanta todo aunque nadie entre.
   - TimeTrigger con repeticion de 2 minutos: revisa seguido y arranca de
     inmediato al instalar la tarea, sin esperar a un reinicio.
   - LogonType Password: corre aunque nadie tenga sesion abierta.
   - RunLevel LeastPrivilege: la app es de solo lectura, no necesita permisos
     de administrador.
   - IgnoreNew: si una revision se alarga, la siguiente se ignora en vez de
     encimarse.
   - ExecutionTimeLimit PT5M: si algo se traba, Windows corta esa revision.
   - Baterias: la caja de la tienda puede estar en un no-break; nunca se debe
     dejar de vigilar por eso.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>La Casita Deli</Author>
    <Description>Vigila la app de inventario en 127.0.0.1:3010 y el tunel de Cloudflare. Corre cada 2 minutos y no muestra ventanas.</Description>
    <URI>\LacasitaInvetory</URI>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
      <Delay>PT1M</Delay>
      <Repetition>
        <Interval>PT2M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </BootTrigger>
    <TimeTrigger>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT2M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USUARIO__</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>wscript.exe</Command>
      <Arguments>//B //Nologo "__RUTA_REPO__\scripts\vigilante.vbs"</Arguments>
      <WorkingDirectory>__RUTA_REPO__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
