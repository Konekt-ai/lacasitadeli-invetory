# ─────────────────────────────────────────────────────────────────────────────
#  Ejemplo del .env — CÓPIALO como .env EN LA COMPUTADORA DE LA TIENDA.
#  El .env de verdad NUNCA se sube a git (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# La app escucha SOLO aquí. A internet sale por el túnel de Cloudflare, que
# apunta nada más a este puerto. No cambies el host.
PUERTO=3010
HOST=127.0.0.1
NODE_ENV=production

# ── SQL Server de NovaCaja (SOLO LECTURA) ────────────────────────────────────
# Usa inventory_ro, NUNCA sa: si esta app quedara con sa, cualquier error podría
# borrar las ventas. El login se crea con scripts/crear-login-ro.sql.
MSSQL_SERVER=localhost
MSSQL_DATABASE=compucaja
MSSQL_USER=inventory_ro
MSSQL_PASSWORD=
MSSQL_PORT=1433

# ── API del panel admin (lacasitadeli-admin) ─────────────────────────────────
# Solo se usa para las solicitudes de resurtido (la ÚNICA acción de esta app) y
# para saber si el admin está vivo. En la caja los dos corren en la misma
# máquina: déjalo así. Otra dirección solo tiene sentido en desarrollo.
ADMIN_API=http://127.0.0.1:3002
# Cuánto se espera al admin antes de contestar "no responde" (milisegundos)
ADMIN_TIMEOUT_MS=10000
# Cada cuántos minutos se vuelve a preguntar si el admin contesta
ADMIN_REVISAR_MIN=5

# ── Quién puede entrar ───────────────────────────────────────────────────────
# Se generan con:  npm run hash-contrasena -- dueno
# Formato: usuario:hash,usuario:hash  (el hash es bcrypt costo 12). El nombre de
# usuario queda como "quién pidió" en las solicitudes de resurtido.
USUARIOS=
# Cualquier texto largo y al azar (24+ caracteres). Si lo cambias, todos vuelven
# a entrar con su usuario y contraseña.
SESSION_SECRET=
# Horas que dura la sesión en el celular
SESION_HORAS=12
# Máximo de intentos fallidos por IP antes de responder 429
LOGIN_INTENTOS_MAX=5
LOGIN_VENTANA_MIN=15

# ── Umbrales (se pueden cambiar sin tocar el código) ─────────────────────────
# "Sin movimiento" a partir de estos días sin venta. OJO: esto NO marca nada como
# "Descontinuado"; eso solo lo decide el dueño en el Admin (Inventario → producto).
SIN_MOVIMIENTO_DIAS=90
# Lento: su última venta fue entre LENTO_DIAS y SIN_MOVIMIENTO_DIAS
LENTO_DIAS=30
# Nuevo: se contó por primera vez hace menos de estos días y todavía no vende
NUEVO_DIAS=30
# Urgente (prioridad alta): le alcanza para menos de estos días
COBERTURA_URGENTE_DIAS=2
# Bajo stock: le alcanza para menos de estos días
COBERTURA_BAJA_DIAS=7
# Cuántos días se quiere tener surtido el anaquel (para el "sugerido")
DIAS_SUGERIDOS=7
# Ventana para sacar "cuánto vende al día"
VENTANA_VENTA_DIARIA_DIAS=14
# Sobrestock: alcanza para más de estos días (y tiene al menos estas piezas)
SOBRESTOCK_DIAS=120
SOBRESTOCK_MIN=24
# "Más vendido": los N primeros por piezas de 30 días (sin cocina)
TOP_MAS_VENDIDOS=50
# Ventana para buscar códigos duplicados
DUPLICADOS_DIAS=120
# Inventario desfasado: ventas registradas con existencia en 0 en estos últimos días
DESFASE_DIAS=90
# Ventas por día (mapas de calor de Movimiento): cuántos días atrás. Si en la caja
# el paso 'ventas-por-dia' del log pasa de 4 s, bájalo a 30.
VENTAS_DIA_DIAS=90

# ── Alertas ──────────────────────────────────────────────────────────────────
# "Estancado demasiado tiempo": sin movimiento desde este tramo (30/60/90/180)
SIN_MOVIMIENTO_ALERTA_DIAS=180
# "Entradas sin ventas": llegó hace estos días y no ha vendido nada desde entonces
ENTRADAS_SIN_VENTA_DIAS=30
# "Sin categoría": solo si vende al menos estas piezas en 30 días (en la tienda casi
# todo es "ABARROTES"; sin este piso salían 9 mil alertas)
SIN_CATEGORIA_MIN_VENTAS_30=10
# "Posible ubicación incorrecta": qué parece refrigerado y en qué áreas no debería estar
REFRIGERADO_CATEGORIAS=QUESOS Y LACTEOS|CARNES|LACTEOS|CONGELADOS
REFRIGERADO_PALABRAS=REFRIGERAD|FROZEN|CONGELAD
REFRIGERADO_AREAS_SOSPECHOSAS=Bodega|Casita 1|Casita 2

# ── Áreas ────────────────────────────────────────────────────────────────────
# De dónde se surte el anaquel (separadas por coma)
AREAS_RESPALDO=Bodega

# ── Comida hecha en la casa (no se resurte) ──────────────────────────────────
COCINA_CATEGORIAS=ESPECIALES LA CASITA|PASTELES Y POSTRES|CHAROLAS BAGUETTES Y CARNES|RESTAURANT|INSUMOS DE COCINA NO VENTA|TERRAZA
COCINA_CODIGOS=0,0505,650082,1000

# ── SQLite del panel admin (solo lectura: fotos, categoría propia, DESCONTINUADO) ──
SQLITE_FOTOS=C:\Users\LACASITA\Desktop\lacasitadeli-admin\apps\api\lacasita.db

# ── Estado propio de la app (alertas descartadas) ────────────────────────────
# Es el único archivo que esta app escribe. Se crea solo.
CARPETA_DATOS=

# ── Cada cuánto se refresca (minutos) ────────────────────────────────────────
REFRESCO_RAPIDO_MIN=5
REFRESCO_MEDIO_MIN=30
REFRESCO_HISTORIAL_HORAS=6
# Si nadie entra en este rato, deja de refrescar para no cargar el punto de venta
REFRESCO_OCIOSO_MIN=60
REFRESCO_FOTOS_MIN=30

# ── Túnel de Cloudflare y aviso de la URL nueva ──────────────────────────────
METRICAS_TUNEL=http://127.0.0.1:3011
TUNEL_ACTIVO=1
# A quién se le avisa cuando cambia la dirección para entrar desde el celular
CORREO_URL=lacasitadeli2000@gmail.com
# Con Resend (lo mismo que usa el panel admin)
RESEND_API_KEY=
# O con Gmail, si no hay Resend
EMAIL_USER=
EMAIL_PASS=
